# SF6 Discord Bot 設定。discord_bot/.env にコピーして使う (.gitignore 済み)。
#   cp discord_bot/.env.example discord_bot/.env

# Discord Developer Portal で発行した Bot トークン
DISCORD_TOKEN=

# AWS MCP サーバのエンドポイントと Bearer トークン
SF6_MCP_URL=https://xxxx.execute-api.ap-northeast-1.amazonaws.com/prod/mcp
SF6_MCP_TOKEN=

# 起動トリガーのプレフィックス (メンションでも反応する)
SF6_BOT_PREFIX=!sf6

# ローカル Ollama (gemma4) 設定。intent 解析と回答生成に使う。
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=300

# ADR-026: 会話からの本人限定戦術メモ。
# 既定disabled: 会話内の短期参照だけを有効にし、何も永続保存しない。
# Supabaseを使う時は先に sql/conversational_knowledge_migration.sql を適用し、
# 十分長いランダム文字列を設定する。Discord IDそのものはDBへ保存しない。
SF6_KNOWLEDGE_STORE=disabled
SF6_KNOWLEDGE_SUBJECT_SECRET=

# 旧来のSuperCombo依存・即時グローバル別名登録は既定で無効。
SF6_ENABLE_LEGACY_SC_ALIAS_LEARNING=0
