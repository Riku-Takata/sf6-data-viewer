{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApiGatewayForSamHttpApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:POST",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE",
        "apigateway:TagResource",
        "apigateway:UntagResource"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-northeast-1::/*"
      ]
    }
  ]
}
